# HamiCard Environment Configuration (.env.example)
# Copy this file to .env for local development

NODE_ENV=development
PORT=3000

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hamicard_dev
DB_USER=hamicard
DB_PASSWORD=hamicard_dev_secret_pass
DATABASE_URL=postgresql://hamicard:hamicard_dev_secret_pass@localhost:5432/hamicard_dev?schema=public

# Cache & Redis (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Authentication & Session Security (AUTH-001..017, AC-14, AC-15)
JWT_ACCESS_SECRET=hamicard_dev_access_token_secret_min_32_chars_long
JWT_REFRESH_SECRET=hamicard_dev_refresh_token_secret_min_32_chars_long
JWT_ACCESS_EXPIRATION_SECONDS=900        # 15 minutes
JWT_REFRESH_EXPIRATION_SECONDS=604800    # 7 days
OTP_EXPIRATION_SECONDS=120               # 2 minutes
OTP_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Encryption Key for Sensitive Bank & PII Data (OPS-006, SEC-002)
# AES-256-GCM hex key (32 bytes = 64 hex characters)
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# External Service Adapters (PAY-010, NOTICE-003, OPEN-11)
# Options: mock | kavenegar | zarinpal
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
